            let text = `*REKAPITULASI KEHADIRAN HARIAN*\nKelas: ${mockState.schoolConfig.className} (${mockState.schoolConfig.schoolName})\nHari/Tanggal: ${new Date().toLocaleDateString('id-ID', {weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'})}\n\n`;
            
            text += `🔴 *SISWA ALFA (TANPA KETERANGAN)*: ${alfaStudents.length} Siswa\n`;
            if (alfaStudents.length > 0) {
                alfaStudents.forEach((s, i) => {
                    text += `${i+1}. ${s.name} (NISN: ${s.nis}) — Ortu: ${s.parent} (${s.parentPhone || '-'})\n`;
                });
            } else {
                text += `- Nihil (Semua hadir / izin / sakit)\n`;
            }

            text += `\n🟡 *SISWA TERLAMBAT*: ${lateStudents.length} Siswa\n`;
            if (lateStudents.length > 0) {
                lateStudents.forEach((s, i) => {
                    text += `${i+1}. ${s.name} (Pukul: ${s.time})\n`;
