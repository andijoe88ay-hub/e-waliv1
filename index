                const el = document.getElementById('currentWIBTime');
                if(el) el.innerText = timeString;
                const de = document.getElementById('currentDateText');
                if(de) de.innerText = now.toLocaleDateString('id-ID', { timeZone: 'Asia/Jakarta', weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' });
            }, 1000);
