        // ---------- Integrasi Pelanggaran & Poin Karakter ke WhatsApp Orang Tua ----------
        function submitViolation() {
            const studId = parseInt(document.getElementById('violStudentId').value);
            const violation = document.getElementById('violDesc').value.trim();
            const category = document.getElementById('violCategory').value;
            const points = parseInt(document.getElementById('violPoints').value) || 5;
            const action = document.getElementById('violAction').value.trim();
            const student = mockState.students.find(x => x.id === studId);
            
            if(!violation || !student) { 
                showToast('Peringatan', 'Deskripsi pelanggaran wajib diisi.'); 
                return; 
            }

            run(async () => { 
                const { error } = await sb.from('violations').insert({ 
                    student_id: studId, 
                    violation, 
                    category, 
                    points: -Math.abs(points), 
                    action: action || 'Pembinaan wali kelas' 
                }); 
                if (error) throw error; 
                closeModal(); 
            }, ['Berhasil Tercatat', `Pelanggaran ${student.name} berhasil disimpan & poin dikurangi.`], 'violations')
            .then(() => {
                if (student.parentPhone) {
                    const currentPts = getStudentPoints(student);
                    const waText = `Yth. Bapak/Ibu Wali Murid dari *${student.name}* (Kelas ${mockState.schoolConfig.className}),\n\nKami menginformasikan catatan tata tertib sekolah ananda:\n• Pelanggaran: *${violation}*\n• Kategori: ${category}\n• Pengurangan Poin: -${Math.abs(points)} Poin\n• Sisa Poin Karakter: ${currentPts}/100\n• Tindakan: ${action || 'Pembinaan wali kelas'}\n\nMohon kerjasamanya untuk membimbing ananda di rumah.\n\n*Wali Kelas ${mockState.schoolConfig.className}* (${mockState.schoolConfig.teacherName})`;
                    
                    if (confirm(`Kirim pemberitahuan pelanggaran ini via WhatsApp ke Orang Tua (${student.parent} - ${student.parentPhone})?`)) {
                        window.open(`https://wa.me/${student.parentPhone}?text=${encodeURIComponent(waText)}`, '_blank');
                    }
                }
            });
        }

