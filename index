        function recalculateStats() {
            let present = 0, late = 0, sick = 0, permitted = 0, alpha = 0, unrecorded = 0;
            mockState.students.forEach(s => {
                if(s.status === 'HADIR') present++;
                else if(s.status === 'TERLAMBAT') late++;
                else if(s.status === 'SAKIT') sick++;
                else if(s.status === 'IZIN') permitted++;
                else if(s.status === 'ALFA') alpha++;
                else unrecorded++;
            });
            mockState.stats.present = present;
            mockState.stats.late = late;
            mockState.stats.sick = sick;
            mockState.stats.permitted = permitted;
            mockState.stats.alpha = alpha;
            mockState.stats.unrecorded = unrecorded;
            mockState.stats.totalStudents = mockState.students.length;
        }

