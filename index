    <script>
        // =====================================================================
        // KONFIGURASI SUPABASE
        // =====================================================================
        const SUPABASE_URL = 'https://gzxtrllrfhepfrlzqsem.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_uQASORoCLZZ3kRga3NpX2g_Va1yaLcB';
        
        const sb = (window.supabase && !SUPABASE_URL.includes('GANTI-DENGAN'))
            ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;

        const DEFAULT_AVATAR = 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80';
        
        const mockState = {
            currentRole: 'walikelas', uid: null,
            schoolConfig: { schoolName: '', department: '', className: '', academicYear: '', principalName: '', principalNip: '', teacherName: '', teacherNip: '', teacherPhone: '', teacherPassword: '', address: '', avatar: DEFAULT_AVATAR },
            currentUser: { id: 0, name: '', role: '', nip: '', avatar: DEFAULT_AVATAR, isQrOfficer: false, phone: '', address: '', parent: 'Wali Kelas', parentPhone: '' },
            qrSettings: { startTime: '06:45', toleranceTime: '07:15', endTime: '08:00', tokenValidSeconds: 30, status: 'AKTIF' },
            stats: { totalStudents: 0, present: 0, late: 0, sick: 0, permitted: 0, alpha: 0, unrecorded: 0 },
            students: [], permissions: [], violations: [], homeVisits: [], counseling: [], tokens: [],
            dailyQuotes: [
                { quote: "Kesuksesan bukanlah kunci kebahagiaan. Kebahagiaan adalah kunci kesuksesan. Jika Anda mencintai apa yang Anda lakukan, Anda akan berhasil.", author: "Albert Schweitzer", type: "Motivasi Harian" },
                { quote: "Belajar tanpa berpikir adalah sia-sia, berpikir tanpa belajar adalah berbahaya.", author: "Confucius", type: "Pendidikan Vokasi" },
                { quote: "Jadilah seperti montir TSM yang handal: selalu tahu persis di mana letak masalahnya dan bagaimana cara memperbaikinya dengan senyuman.", author: "Kearifan Anak TSM", type: "Jokes Santri" }
            ]
        };
        let lastScan = { nis: '', at: 0 };

        // ---------- Helper ----------
        const BLN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
        function fmtDate(iso) { if (!iso) return '-'; const [y, m, d] = String(iso).slice(0, 10).split('-'); return `${parseInt(d)} ${BLN[parseInt(m) - 1]} ${y}`; }
        function todayISO() { return new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' }); }
        function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
        function errMsg(e) {
            const m = (e && (e.message || e.error_description)) || String(e);
            if (/SISWA_TIDAK_DITEMUKAN/.test(m)) return 'NISN tidak ditemukan di kelas ini.';
            if (/Invalid login credentials/i.test(m)) return 'Email atau password salah.';
            if (e && e.code === '23505') return 'NISN sudah terdaftar di kelas ini.';
            return m;
        }
        function needSb() {
            if (sb) return false;
            showToast('Konfigurasi Belum Diisi', 'Isi SUPABASE_URL dan SUPABASE_ANON_KEY dengan benar.');
            return true;
        }
        function compressImage(file, max, cb) {
            const r = new FileReader();
            r.onload = e => {
                const img = new Image();
                img.onload = () => {
                    const k = Math.min(1, max / Math.max(img.width, img.height));
                    const c = document.createElement('canvas');
                    c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
                    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                    cb(c.toDataURL('image/jpeg', 0.75));
                };
                img.onerror = () => cb(null);
                img.src = e.target.result;
            };
            r.readAsDataURL(file);
        }
        async function run(fn, okMsg, route) {
            if (needSb()) return;
            try {
                await fn();
                await loadAll();
                if (okMsg) showToast(okMsg[0], okMsg[1]);
                if (route) renderView(route);
            } catch (e) { showToast('Gagal Menyimpan', errMsg(e)); }
        }

        // ---------- Muat Semua Data dari Supabase ----------
        async function loadAll() {
            const uid = mockState.uid;
            if (!uid) return;
            const q = (t) => sb.from(t).select('*').order('created_at', { ascending: false });
            const res = await Promise.all([
                sb.from('profiles').select('*').eq('id', uid).maybeSingle(),
                sb.from('students').select('*').order('nis'),
                sb.from('attendance').select('student_id,att_date,status,scan_time'),
                q('violations'), q('counseling'), q('home_visits'), q('permissions'),
                sb.from('class_tokens').select('*').eq('is_active', true).gt('expires_at', new Date().toISOString()).order('created_at', { ascending: false })
            ]);
            res.forEach(r => { if (r.error) throw r.error; });
            let prof = res[0].data;
            if (!prof) {
                const ins = await sb.from('profiles').insert({ id: uid }).select().single();
                if (ins.error) throw ins.error;
                prof = ins.data;
            }
            const sc = mockState.schoolConfig;
            Object.assign(sc, { schoolName: prof.school_name, department: prof.department, className: prof.class_name, academicYear: prof.academic_year, principalName: prof.principal_name, principalNip: prof.principal_nip, teacherName: prof.teacher_name, teacherNip: prof.teacher_nip, teacherPhone: prof.teacher_phone, address: prof.address, avatar: prof.avatar || DEFAULT_AVATAR });
            mockState.qrSettings.startTime = prof.qr_start;
            mockState.qrSettings.toleranceTime = prof.qr_tolerance;

            const today = todayISO();
            const sum = {}, todayRow = {};
            res[2].data.forEach(a => {
                const m = sum[a.student_id] || (sum[a.student_id] = { hadir: 0, terlambat: 0, sakit: 0, izin: 0, alfa: 0 });
                m[a.status.toLowerCase()]++;
                if (a.att_date === today) todayRow[a.student_id] = a;
            });
            const byId = {};
            mockState.students = res[1].data.map(r => {
                const t = todayRow[r.id];
                const st = { id: r.id, nis: r.nis, name: esc(r.name), gender: r.gender, phone: esc(r.phone), parent: esc(r.parent), parentPhone: esc(r.parent_phone), address: esc(r.address), mapLink: r.map_link, avatar: r.avatar || DEFAULT_AVATAR, isQrOfficer: r.is_qr_officer || false,
                    status: t ? t.status : 'BELUM', time: t ? t.scan_time : '-', attendanceSummary: sum[r.id] || { hadir: 0, terlambat: 0, sakit: 0, izin: 0, alfa: 0 },
                    username: r.nis, accountStatus: r.is_active ? 'Aktif' : 'Nonaktif', lastLogin: t ? `${t.status} • ${t.scan_time}` : '-' };
                byId[r.id] = st; return st;
            });
            const who = id => byId[id] || { name: 'Siswa (dihapus)', nis: '-' };
            mockState.violations = res[3].data.map(r => ({ id: r.id, studentName: who(r.student_id).name, nis: who(r.student_id).nis, date: fmtDate(r.vio_date), violation: esc(r.violation), category: r.category, points: r.points, action: esc(r.action) }));
            mockState.counseling = res[4].data.map(r => ({ id: r.id, studentName: who(r.student_id).name, nis: who(r.student_id).nis, date: fmtDate(r.c_date), category: esc(r.category), description: esc(r.description), action: esc(r.action), result: esc(r.result), status: r.status }));
            mockState.homeVisits = res[5].data.map(r => ({ id: r.id, studentName: who(r.student_id).name, nis: who(r.student_id).nis, date: fmtDate(r.visit_date), officer: esc(r.officer), reason: esc(r.reason), result: esc(r.result), status: r.status, evidenceUrl: r.evidence_url }));
            mockState.permissions = res[6].data.map(r => ({ id: r.id, studentId: r.student_id, studentName: who(r.student_id).name, nis: who(r.student_id).nis, category: r.category, date: fmtDate(r.perm_date), rawDate: r.perm_date, reason: esc(r.reason), status: r.status }));
            mockState.tokens = res[7].data.map(r => ({ id: r.id, token: r.token, label: esc(r.label), expiresText: new Date(r.expires_at).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' }) + ' WIB' }));
            recalculateStats();
        }

        // ---------- Autentikasi Login (Wali Kelas & Siswa) ----------
        async function startTeacherSession(user) {
            mockState.currentRole = 'walikelas';
            mockState.uid = user.id;
            await loadAll();
            const sc = mockState.schoolConfig;
            mockState.currentUser = { id: 0, name: sc.teacherName, role: `Wali Kelas ${sc.className}`, nip: sc.teacherNip, avatar: sc.avatar, isQrOfficer: false, phone: sc.teacherPhone, address: sc.schoolName, parent: 'Wali Kelas', parentPhone: sc.teacherPhone };
            proceedLoginSuccess();
        }

        async function startStudentSession(student) {
            mockState.currentRole = 'siswa';
            const { data: profs } = await sb.from('profiles').select('*').limit(1);
            if (profs && profs.length > 0) {
                const prof = profs[0];
                mockState.uid = prof.id;
                await loadAll();
            }
            const found = mockState.students.find(s => s.nis === student.nis) || student;
            mockState.currentUser = { 
                id: found.id, 
                name: found.name, 
