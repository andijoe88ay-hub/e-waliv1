        async function handleLogin() {
            if (needSb()) return;
            const role = document.getElementById('loginRoleSelect').value;
            const idv = document.getElementById('loginUsername').value.trim();
            const pw = document.getElementById('loginPassword').value;
            if (!idv || (role === 'walikelas' && !pw)) { 
                showToast('Peringatan', role === 'walikelas' ? 'Email dan password wajib diisi.' : 'NISN wajib diisi.'); 
                return; 
            }
            const btn = document.querySelector('#loginView button[onclick="handleLogin()"]');
            btn.disabled = true; btn.style.opacity = '.6';
            try {
                if (role === 'walikelas') {
                    const { data, error } = await sb.auth.signInWithPassword({ email: idv, password: pw });
                    if (error) throw error;
                    await startTeacherSession(data.user);
                } else {
                    const { data, error } = await sb.from('students').select('*').eq('nis', idv).maybeSingle();
                    if (error || !data) throw new Error('NISN tidak ditemukan di kelas ini.');
                    if (data.is_active === false) throw new Error('Akun siswa ini sedang dinonaktifkan.');
                    await startStudentSession(data);
                }
