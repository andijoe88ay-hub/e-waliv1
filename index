            const fileInput = document.getElementById('localAvatarFile');
            const upd = { phone: document.getElementById('editPhone').value, parent: document.getElementById('editParent').value, parent_phone: document.getElementById('editParentPhone').value, address: document.getElementById('editAddress').value };
            const save = (avatar) => {
                if (avatar) upd.avatar = avatar;
                run(async () => { const { error } = await sb.from('students').update(upd).eq('id', studentId); if (error) throw error; closeModal(); },
                    ['Berhasil', 'Biodata berhasil diperbarui.']).then(() => renderStudentProfileView(studentId));
            };
            if (fileInput && fileInput.files && fileInput.files[0]) compressImage(fileInput.files[0], 320, save); else save(null);
        }

        function renderViolationsView(container) {
            container.innerHTML = `
                <div class="space-y-6">
                    <div class="bg-white rounded-3xl p-6 md:p-8 border border-santara-border shadow-sm flex items-center justify-between">
                        <div><h3 class="text-lg font-bold text-santara-navy">Pencatatan Pelanggaran & Poin Karakter</h3><p class="text-xs text-santara-textSec mt-0.5">Basis 100 Poin Karakter • Terintegrasi otomatis ke WhatsApp Orang Tua.</p></div>
                        <button onclick="openAddViolationModal()" class="px-5 py-3 bg-red-600 hover:bg-red-700 text-white rounded-2xl text-xs font-bold shadow-md"><i class="fa-solid fa-plus mr-1"></i> Catat Pelanggaran</button>
                    </div>
                    <div class="bg-white rounded-3xl border border-santara-border shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-gray-50 text-santara-textSec uppercase font-semibold border-b">
                                    <tr><th class="p-3.5">Tanggal</th><th class="p-3.5">Nama Siswa</th><th class="p-3.5">Jenis Pelanggaran</th><th class="p-3.5">Kategori</th><th class="p-3.5">Poin</th><th class="p-3.5">Tindakan</th><th class="p-3.5 text-right">Aksi</th></tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    ${mockState.violations.map(v => `
                                        <tr class="hover:bg-gray-50 transition">
                                            <td class="p-3.5 text-gray-600">\${v.date}</td>
                                            <td class="p-3.5 font-bold text-santara-navy">\${v.studentName}<br><span class="font-mono text-[10px] text-gray-500">\${v.nis}</span></td>
                                            <td class="p-3.5 text-gray-800">\${v.violation}</td>
                                            <td class="p-3.5"><span class="px-2.5 py-1 bg-red-50 text-red-700 rounded-lg font-bold">\${v.category}</span></td>
                                            <td class="p-3.5 font-mono font-bold text-red-600">\${v.points} Poin</td>
                                            <td class="p-3.5 text-gray-600">\${v.action}</td>
                                            <td class="p-3.5 text-right"><button onclick="deleteViolation(\${v.id})" class="px-2.5 py-1.5 bg-red-50 text-red-600 rounded-xl font-bold text-[10px]"><i class="fa-solid fa-trash"></i></button></td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        function openAddViolationModal() {
            const modal = document.getElementById('modalContainer');
            const box = document.getElementById('modalContentBox');
            box.innerHTML = `
                <div class="bg-santara-navy text-white p-4 flex items-center justify-between">
                    <h3 class="font-bold text-sm">Form Catat Pelanggaran & Kirim WA ke Ortu</h3>
                    <button onclick="closeModal()" class="text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <div class="p-6 space-y-4 text-xs">
                    <div><label class="block font-bold mb-1 uppercase">PILIH SISWA</label><select id="violStudentId" class="w-full p-3.5 border rounded-xl font-semibold bg-gray-50">${mockState.students.map(s => `<option value="\${s.id}">${s.name} (NIS:${s.nis})</option>`).join('')}</select></div>
                    <div><label class="block font-bold mb-1 uppercase">BENTUK PELANGGARAN</label><input type="text" id="violDesc" class="w-full p-3.5 border rounded-xl" placeholder="Contoh: Terlambat hadir..."></div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="block font-bold mb-1 uppercase">KATEGORI</label><select id="violCategory" class="w-full p-3.5 border rounded-xl"><option value="Ringan">Ringan</option><option value="Sedang">Sedang</option><option value="Berat">Berat</option></select></div>
                        <div><label class="block font-bold mb-1 uppercase">JUMLAH POIN PENGURANG</label><input type="number" id="violPoints" class="w-full p-3.5 border rounded-xl" value="5"></div>
                    </div>
                    <div><label class="block font-bold mb-1 uppercase">TINDAKAN PEMBINAAN</label><input type="text" id="violAction" class="w-full p-3.5 border rounded-xl" value="Pembinaan wali kelas"></div>
                    <button onclick="submitViolation()" class="w-full py-3.5 bg-red-600 text-white font-bold rounded-xl shadow-md">Simpan & Kirim Notifikasi ke WhatsApp Ortu</button>
                </div>
            `;
            modal.classList.add('flex'); modal.classList.remove('hidden');
        }

        async function deleteViolation(id) {
            run(async () => { const { error } = await sb.from('violations').delete().eq('id', id); if (error) throw error; },
                ['Berhasil', 'Catatan pelanggaran dihapus.'], 'violations');
        }

        function renderCounselingView(container) { container.innerHTML = `<div class="bg-white rounded-3xl p-6 border shadow-sm"><h3 class="text-lg font-bold text-santara-navy">Manajemen Pembinaan & Konseling BK</h3><p class="text-xs text-gray-500 mt-1">Gunakan tombol tambah untuk merekam sesi konseling.</p></div>`; }
        function renderHomeVisitView(container) { container.innerHTML = `<div class="bg-white rounded-3xl p-6 border shadow-sm"><h3 class="text-lg font-bold text-santara-navy">Home Visit & Dokumentasi Kunjungan</h3><p class="text-xs text-gray-500 mt-1">Pencatatan kunjungan rumah dan dokumentasi foto.</p></div>`; }
        function renderReportsView(container) { container.innerHTML = `<div class="bg-white rounded-3xl p-6 border shadow-sm"><h3 class="text-lg font-bold text-santara-navy">Pusat Laporan A4</h3><p class="text-xs text-gray-500 mt-1">Cetak laporan rekapitulasi kehadiran dan kedisiplinan resmi sekolah.</p></div>`; }
        function renderCariCetakIndivView(container) { container.innerHTML = `<div class="bg-white rounded-3xl p-6 border shadow-sm"><h3 class="text-lg font-bold text-santara-navy">Cari & Cetak Profil 360° Siswa</h3></div>`; }
        function renderSettingsView(container) { container.innerHTML = `<div class="bg-white rounded-3xl p-6 border shadow-sm"><h3 class="text-lg font-bold text-santara-navy">Pengaturan Identitas Sekolah</h3></div>`; }
    </script>
</body>
</html>
