        async function recordStudentAttendanceScan(text) {
            if (!text || needSb()) return;
            const now = new Date();
            const timeStr = now.toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', hour12: false });
            const tolerance = mockState.qrSettings.toleranceTime || '07:15';
            const status = timeStr > tolerance ? 'TERLAMBAT' : 'HADIR';
            const today = todayISO();

            try {
                const { error } = await sb.from('attendance').upsert({
                    student_id: mockState.currentUser.id,
                    att_date: today,
                    status: status,
                    scan_time: timeStr,
                    source: 'qr_mandiri'
                }, { onConflict: 'student_id,att_date' });

                if (error) throw error;
                showToast('Absensi Berhasil', `Kehadiran tercatat: ${status} pukul ${timeStr} WIB`);
                
                if (activeHtml5QrCode) {
                    await activeHtml5QrCode.stop().catch(() => {});
                    activeHtml5QrCode.clear();
                    activeHtml5QrCode = null;
                }
                await loadAll();
                renderView('dashboard');
            } catch (e) {
                showToast('Gagal Absen', errMsg(e));
            }
        }

